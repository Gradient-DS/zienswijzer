frontend/.expo-shared/
frontend/dist/
frontend/npm-debug.*
frontend/.env
frontend/.env.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*.iml

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

pdfs

