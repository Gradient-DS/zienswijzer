# Microsoft Outlook Email Integration Configuration
# ================================================
# 
# This file shows the required environment variables for the email integration.
# Copy this file to .env and fill in your actual values from Azure AD.
#
# To get these values:
# 1. Go to https://portal.azure.com/
# 2. Navigate to Azure Active Directory → App registrations → Your App
# 3. Find the values on the Overview page and Certificates & secrets page

# REQUIRED: OAuth Client ID from your Azure App Registration
# Found on the Overview page (UUID format)
MICROSOFT_CLIENT_ID=your-client-id-here

# REQUIRED: OAuth Client Secret from Certificates & secrets
# IMPORTANT: Copy this when you create it - you can't view it again!
MICROSOFT_CLIENT_SECRET=your-client-secret-here

# REQUIRED: Your Azure AD Tenant ID (single-tenant setup)
# Found on the Azure AD Overview page under "Tenant ID"
# This makes the app single-tenant, only allowing your organization to authenticate
MICROSOFT_TENANT_ID=your-tenant-id-here

# OPTIONAL: OAuth callback URL (must match your Azure App Registration redirect URI)
# Default: http://localhost:8000/email/callback
MICROSOFT_REDIRECT_URI=http://localhost:8000/email/callback

# OPTIONAL: Microsoft Graph API endpoint
# Default: https://graph.microsoft.com/v1.0
# MICROSOFT_GRAPH_API_ENDPOINT=https://graph.microsoft.com/v1.0

# OPTIONAL: OAuth scopes (comma-separated)
# Default: User.Read,Mail.Read,Mail.Send,Mail.ReadWrite
# MICROSOFT_SCOPES=User.Read,Mail.Read,Mail.Send,Mail.ReadWrite

# OPTIONAL: Maximum emails per API request
# Default: 100
# MICROSOFT_MAX_EMAILS_PER_REQUEST=100

# OPTIONAL: Default emails per page
# Default: 10
# MICROSOFT_DEFAULT_EMAILS_PER_PAGE=10
