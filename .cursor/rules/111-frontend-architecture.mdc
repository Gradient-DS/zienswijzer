### 3. QueryClient Configuration (Background Sync)

```typescript
// src/api/client.ts
import { QueryClient } from '@tanstack/react-query';
import axios from 'axios';

export const queryClient = new QueryClient({
  defaultOptions: {
    queries: {
      staleTime: 5 * 60 * 1000,        // 5 min before marked stale
      gcTime: 10 * 60 * 1000,          // Cache for 10 min
      refetchOnWindowFocus: true,       // Refetch when window regains focus
      refetchOnReconnect: true,         // Refetch when reconnected
      retry: 2,                         // Retry failed requests twice
    },
    mutations: {
      retry: 1,
    },
  },
});

// Axios instance with base configuration
export const apiClient = axios.create({
  baseURL: import.meta.env.VITE_API_BASE_URL || 'http://localhost:8000',
  headers: {
    'Content-Type': 'application/json',
  },
  withCredentials: true, // For cookies/sessions
});
```

### 4. TanStack Query for Server State

```typescript
// src/api/workspaces.ts
import { useQuery, useMutation, useQueryClient } from '@tanstack/react-query';
import { apiClient } from './client';
import type { Workspace, WorkspaceUpdate, WorkspaceCreate } from '@/types';

// Query: Fetch all workspaces
export const useWorkspaces = () => {
  return useQuery({
    queryKey: ['workspaces'],
    queryFn: async () => {
      const res = await apiClient.get('/workspaces');
      return res.data as Workspace[];
    },
  });
};

// Query: Fetch single workspace
export const useWorkspace = (workspaceId: string | undefined) => {
  return useQuery({
    queryKey: ['workspaces', workspaceId],
    queryFn: async () => {
      const res = await apiClient.get(`/workspaces/${workspaceId}`);
      return res.data as Workspace;
    },
    enabled: !!workspaceId, // Don't run if no ID
  });
};

// Mutation: Create workspace
export const useCreateWorkspace = () => {
  const queryClient = useQueryClient();
  return useMutation({
    mutationFn: (data: WorkspaceCreate) =>
      apiClient.post('/workspaces', data),
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ['workspaces'] });
    },
  });
};

// Mutation: Update workspace
export const useUpdateWorkspace = () => {
  const queryClient = useQueryClient();
  return useMutation({
    mutationFn: ({ id, ...data }: WorkspaceUpdate) =>
      apiClient.put(`/workspaces/${id}`, data),
    onSuccess: (_, variables) => {
      queryClient.invalidateQueries({
        queryKey: ['workspaces', variables.id],
      });
    },
  });
};
```

### 5. Zustand Store for UI State

```typescript
// src/store/ui-store.ts
import { create } from 'zustand';

interface UIState {
  isCreateModalOpen: boolean;
  isSettingsOpen: boolean;
  selectedWorkspaceId: string | null;
  
  setCreateModalOpen: (open: boolean) => void;
  setSettingsOpen: (open: boolean) => void;
  setSelectedWorkspaceId: (id: string | null) => void;
}

export const useUIStore = create<UIState>((set) => ({
  isCreateModalOpen: false,
  isSettingsOpen: false,
  selectedWorkspaceId: null,
  
  setCreateModalOpen: (open) => set({ isCreateModalOpen: open }),
  setSettingsOpen: (open) => set({ isSettingsOpen: open }),
  setSelectedWorkspaceId: (id) => set({ selectedWorkspaceId: id }),
}));
```

### 6. Using Both Together in a Component

```typescript
// src/components/features/WorkspaceList.tsx
import { useWorkspaces } from '@/api/workspaces';
import { useUIStore } from '@/store/ui-store';
import { WorkspaceCard } from './WorkspaceCard';
import { Button } from '@/components/ui/button';
import { Skeleton } from '@/components/ui/skeleton';

export function WorkspaceList() {
  // Server state (TanStack Query)
  const { data: workspaces, isLoading, error } = useWorkspaces();
  
  // UI state (Zustand)
  const { selectedWorkspaceId, setCreateModalOpen } = useUIStore();

  if (isLoading) {
    return (
      <div className="space-y-4">
        <Skeleton className="h-12 w-full" />
        <Skeleton className="h-24 w-full" />
        <Skeleton className="h-24 w-full" />
      </div>
    );
  }

  if (error) {
    return (
      <div className="text-center py-8">
        <p className="text-destructive">Failed to load workspaces</p>
      </div>
    );
  }

  return (
    <div className="space-y-4">
      <Button onClick={() => setCreateModalOpen(true)}>
        Create Workspace
      </Button>
      
      {workspaces?.map((workspace) => (
        <WorkspaceCard
          key={workspace.id}
          workspace={workspace}
          isActive={workspace.id === selectedWorkspaceId}
          onSelect={() => setSelectedWorkspaceId(workspace.id)}
        />
      ))}
    </div>
  );
}
```

