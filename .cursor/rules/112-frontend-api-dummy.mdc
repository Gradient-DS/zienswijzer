#### 6. Highlight Color Strategy
Assign colors based on stakeholder type and confidence:

```typescript
const STAKEHOLDER_COLORS = {
  organization: '#3B82F6', // Blue
  individual: '#10B981',   // Green
  government: '#F59E0B',   // Amber
  community: '#8B5CF6',    // Purple
  environmental: '#059669', // Emerald
  default: '#6B7280'       // Gray
};

function getHighlightColor(mention: StakeholderMention): string {
  const baseColor = STAKEHOLDER_COLORS[mention.stakeholderType] || STAKEHOLDER_COLORS.default;
  return baseColor;
}

function getHighlightOpacity(confidence: number): number {
  // Lower confidence = more transparent
  // 0.5 = 50% confidence = 50% opacity
  // 1.0 = 100% confidence = 100% opacity
  return Math.max(0.3, confidence); // Minimum 30% opacity
}

function getHighlightStyle(mention: StakeholderMention): CSSProperties {
  const color = getHighlightColor(mention);
  const opacity = getHighlightOpacity(mention.confidence);
  
  return {
    backgroundColor: `${color}${Math.round(opacity * 255).toString(16)}`, // Add alpha
    border: mention.verified ? `2px solid ${color}` : `2px dashed ${color}`,
    borderRadius: '2px',
    cursor: 'pointer',
    transition: 'all 0.2s ease'
  };
}

// Visual confidence indicator
function ConfidenceBadge({ confidence }: { confidence: number }) {
  const percentage = Math.round(confidence * 100);
  const colorClass = confidence >= 0.9 ? 'bg-green-500' : 
                     confidence >= 0.7 ? 'bg-yellow-500' : 
                     'bg-red-500';
  
  return (
    <span className={`px-2 py-1 rounded text-xs font-semibold ${colorClass}`}>
      {percentage}%
    </span>
  );
}
```

### Backend Processing Pipeline

#### 1. Upload Handler
```python
@app.post("/documents/upload")
async def upload_documents(
    files: List[UploadFile],
    case_id: str,
    background_tasks: BackgroundTasks
):
    # 1. Validate files (PDF only, size limits)
    # 2. Store files to disk/S3
    # 3. Create Document records (status: "pending")
    # 4. Queue background processing tasks
    # 5. Return upload status immediately
    
    for file in files:
        document = create_document_record(file, case_id)
        background_tasks.add_task(process_document, document.id)
    
    return {"documents": upload_statuses}
```

#### 2. Document Processor
```python
async def process_document(document_id: str):
    # Update status to "processing"
    update_document_status(document_id, "processing", progress=0)
    
    try:
        # Step 1: Extract text from PDF (progress: 0-30%)
        pdf_content = extract_pdf_content(document_id)
        update_progress(document_id, 30, "extracting_text")
        
        # Step 2: Identify stakeholders via NER (progress: 30-60%)
        identified_stakeholders = identify_entities(pdf_content)
        update_progress(document_id, 60, "identifying_entities")
        
        # Step 3: Create chunks with bboxes (progress: 60-90%)
        chunks = create_chunks_with_bboxes(pdf_content, identified_stakeholders)
        update_progress(document_id, 90, "chunking")
        
        # Step 4: Save to database (progress: 90-100%)
        save_chunks_and_stakeholders(document_id, chunks, identified_stakeholders)
        
        # Mark as completed
        update_document_status(document_id, "completed", progress=100)
        
    except Exception as e:
        update_document_status(document_id, "failed", error=str(e))
```

#### 3. Text Extraction with Bounding Boxes
```python
import pdfplumber

def extract_pdf_content(document_id: str):
    pdf = pdfplumber.open(get_document_path(document_id))
    
    pages = []
    for page_num, page in enumerate(pdf.pages):
        # Extract text with coordinates
        words = page.extract_words()
        
        # Group words into chunks (paragraphs, sentences, etc.)
        chunks = group_words_into_chunks(words)
        
        pages.append({
            "page_number": page_num + 1,
            "chunks": chunks,
            "dimensions": {
                "width": page.width,
                "height": page.height
            }
        })
    
    return pages
```

#### 4. Entity Recognition (Stakeholder Identification)
```python
import spacy

def identify_entities(pdf_content):
    nlp = spacy.load("en_core_web_sm")
    
    chunk_stakeholder_mentions = []
    
    for page in pdf_content:
        for chunk in page["chunks"]:
            doc = nlp(chunk["text"])
            
            # Extract organizations, persons, locations
            for ent in doc.ents:
                if ent.label_ in ["ORG", "PERSON", "GPE"]:
                    # Create ChunkStakeholder record with confidence
                    chunk_stakeholder = {
                        "chunk_id": chunk["id"],
                        "stakeholder_name": ent.text,
                        "stakeholder_type": map_entity_type(ent.label_),
                        "confidence": calculate_confidence(ent, doc),
                        "mention_text": ent.text,
                        "mention_bbox": calculate_mention_bbox(ent, chunk["words"]),
                        "verified": False  # Requires human verification
                    }
                    chunk_stakeholder_mentions.append(chunk_stakeholder)
    
    # Find or create stakeholder records and link to chunks
    return process_and_link_stakeholders(chunk_stakeholder_mentions)

def calculate_confidence(entity, doc):
    """
    Calculate confidence score based on:
    - SpaCy's entity confidence
    - Context (surrounding words)
    - Entity length and completeness
    - Pattern matching (known stakeholder formats)
    """
    base_confidence = 0.7  # SpaCy base confidence
    
    # Adjust based on context
    if has_title_case(entity.text):
        base_confidence += 0.1
    
    if has_organizational_suffix(entity.text):  # Inc, Ltd, Agency, etc.
        base_confidence += 0.1
    
    if appears_in_formal_context(entity, doc):
        base_confidence += 0.1
    
    return min(base_confidence, 1.0)

def calculate_mention_bbox(entity, chunk_words):
    """
    Find exact bounding box of the entity mention within the chunk
    by matching entity text to word positions
    """
    entity_words = entity.text.split()
    # Match entity words to chunk words and get their bboxes
    # Return combined bbox covering all entity words
    return find_word_positions(entity_words, chunk_words)
```

### Frontend API Integration

#### Upload Hook
```typescript
// src/api/documents.ts
export const useUploadDocuments = () => {
  const queryClient = useQueryClient();
  
  return useMutation({
    mutationFn: async (data: { files: File[]; caseId: string }) => {
      const formData = new FormData();
      data.files.forEach(file => formData.append('files', file));
      formData.append('caseId', data.caseId);
      
      const response = await apiClient.post('/documents/upload', formData, {
        headers: { 'Content-Type': 'multipart/form-data' },
        onUploadProgress: (progressEvent) => {
          const percentCompleted = Math.round(
            (progressEvent.loaded * 100) / progressEvent.total
          );
          // Update upload progress UI
        }
      });
      
      return response.data;
    },
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ['documents'] });
    }
  });
};
```

#### Processing Status Hook
```typescript
// src/hooks/useDocumentProcessing.ts
export const useDocumentProcessing = (documentId: string) => {
  return useQuery({
    queryKey: ['documents', documentId, 'status'],
    queryFn: async () => {
      const res = await apiClient.get(`/documents/${documentId}/status`);
      return res.data as DocumentProcessingStatusResponse;
    },
    refetchInterval: (data) => {
      // Stop polling when completed or failed
      if (data?.status === 'completed' || data?.status === 'failed') {
        return false;
      }
      return 2000; // Poll every 2 seconds while processing
    },
    enabled: !!documentId
  });
};
```

#### Document Detail with Highlights Hook
```typescript
// src/api/documents.ts
export const useDocumentWithHighlights = (documentId: string) => {
