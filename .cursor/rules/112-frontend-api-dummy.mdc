  action: string; // e.g., "status_changed", "user_assigned", "priority_updated"
  previousValue?: string;
  newValue?: string;
  createdAt: string;
}

// PUT /issues/:id
interface UpdateIssueRequest {
  assignedUserIds?: string[];
  status?: "open" | "in_progress" | "resolved" | "closed";
  priority?: "low" | "medium" | "high" | "urgent";
  description?: string;
}

interface UpdateIssueResponse {
  issue: Issue;
}

// POST /issues/:id/assign
interface AssignUsersRequest {
  userIds: string[];
  replaceExisting?: boolean; // true: replace all, false: add to existing
}

interface AssignUsersResponse {
  issue: Issue;
}

// POST /issues/:id/comments
interface AddCommentRequest {
  content: string;
}

interface AddCommentResponse {
  comment: Comment;
}

// GET /issues/my-assignments
// Get all issues assigned to current user
interface MyAssignmentsResponse {
  issues: IssueWithContext[];
}

interface IssueWithContext extends Issue {
  chunk: Chunk;
  stakeholder: Stakeholder;
  document: Document;
  case: Case;
}
